{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "HOSTNAME",
    "DATABASE_URL",
    "API_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_TRUSTED_ORIGINS",
    "AUTH_RATE_LIMIT_DISABLED",
    "SEED_OPERATOR_EMAIL",
    "SEED_OPERATOR_PASSWORD",
    "SEED_OPERATOR_NAME",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED",
    "DO_NOT_TRACK"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**", "openapi.json"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "generate:client": {
      "dependsOn": ["@supertool/api#build"],
      "cache": false
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "stylelint": {},
    "stylelint:fix": {
      "cache": false
    },
    "fmt": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    }
  }
}
