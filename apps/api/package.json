{
  "name": "@supertool/api",
  "version": "0.0.0",
  "private": true,
  "description": "supertool NestJS API — better-auth host, owns PostgreSQL",
  "scripts": {
    "build": "nest build && node dist/emit-openapi.js",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@nestjs/common": "11.1.26",
    "@nestjs/core": "11.1.26",
    "@nestjs/platform-express": "11.1.26",
    "@nestjs/swagger": "11.4.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "nestjs-pino": "4.6.1",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.26",
    "@supertool/typescript-config": "workspace:*",
    "@swc/core": "1.15.41",
    "@types/node": "22.19.20",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.69.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.8"
  }
}
